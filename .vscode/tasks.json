{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Clear Python caches",
      "type": "shell",
      "command": "python",
      "args": [
        "${workspaceFolder}/scripts/clear_pycache.py",
        "${workspaceFolder}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    }
  ]
}
